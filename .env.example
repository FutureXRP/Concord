# ===== Language model (ALL OPTIONAL - the app is standalone by default) =====
# With nothing set, Concord runs in sources mode: deterministic validation,
# retrieval over the checked-in corpus, and verbatim cited excerpts. No API,
# no network, no keys.

# Force a mode: none | local | anthropic  (default: auto-detect)
CONCORD_LLM=

# Local LLM (Ollama / llama.cpp server / LM Studio - OpenAI-compatible).
# Runs entirely on your machine. e.g. `ollama serve` + `ollama pull llama3.1`
CONCORD_LLM_BASE_URL=http://localhost:11434/v1
CONCORD_LLM_MODEL=llama3.1

# Hosted Claude (optional, best synthesis quality)
ANTHROPIC_API_KEY=

# Gate 3 entailment verification (on whenever a model is configured; 0 disables)
CONCORD_ENTAILMENT=

# ===== Supabase (OPTIONAL - only for pgvector semantic retrieval) =====
# Without it, retrieval runs in-process over data/sources/ (BM25 + exact refs).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings provider for Supabase ingest (1024-dim; e.g. Voyage AI voyage-3)
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3

# ===== YouVersion (Phase 5 - proxy layer; leave unset until license verified) =====
YOUVERSION_API_KEY=
